---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header/Header.astro";
import Hero from "../sections/hero/Hero.astro";
import Portfolio from "../sections/portfolio/Portfolio.astro";
import Services from "../sections/servicios/Services.astro";
import Philosophy from "../sections/philosophy/Philosophy.astro";
import Cta from "../sections/cta/Cta.astro";
import Footer from "../components/Footer/Footer.astro";

// Buena práctica: Si creas tu footer como un componente separado, lo importas aquí
// import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Portfolio />
    <Services />
    <Philosophy />
    <Cta />
  </main>
  <Footer />
</BaseLayout>
<!-- Script desacoplado para inicializar las animaciones de GSAP en el cliente -->
<script>
  import { initAnimations } from "../animations";

  document.addEventListener("DOMContentLoaded", () => {
    initAnimations();
  });
</script>
