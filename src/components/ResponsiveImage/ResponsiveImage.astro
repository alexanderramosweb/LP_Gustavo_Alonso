---
import "./ResponsiveImage.css";
import type { ImageSource } from "../../types/image";

interface Props {
  image: ImageSource;
  alt: string;
  loading?: "lazy" | "eager";
  className?: string; // Para aplicar clases de aspect-ratio o layout
}

const { image, alt, loading = "lazy", className = "" } = Astro.props;
---

<picture class={`responsive-image ${className}`}>
  <source srcset={image.avif.src} type="image/avif" />
  <source srcset={image.webp.src} type="image/webp" />
  <img
    class="responsive-image__img"
    src={image.webp.src}
    alt={alt}
    width={image.webp.width}
    height={image.webp.height}
    loading={loading}
    decoding="async"
  />
</picture>
